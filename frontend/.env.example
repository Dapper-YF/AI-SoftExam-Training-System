# VITE_* values are compiled into the browser bundle and are not secrets.
# Mock credentials are for local-only exercises. Never use real accounts,
# passwords, tokens, admission tickets, identity numbers, or other sensitive data.
VITE_API_BASE_URL=/api/v1
VITE_PLATFORM_MOCK=false
VITE_ADMIN_QUESTION_MOCK=false
VITE_EXAM_SIMULATOR_MOCK=false
VITE_EXAM_SIMULATOR_START_DELAY_SECONDS=15
# Local development only. Keeps the confirmed AI essay entry visible and enables its shell preview.
VITE_ESSAY_DEV_PREVIEW=false
# Set the following only in an uncommitted local environment when Mock is explicitly enabled.
VITE_MOCK_STUDENT_IDENTIFIER=
VITE_MOCK_STUDENT_PASSWORD=
VITE_MOCK_STUDENT_DISPLAY_NAME=
VITE_MOCK_ADMIN_IDENTIFIER=
VITE_MOCK_ADMIN_PASSWORD=
VITE_MOCK_ADMIN_DISPLAY_NAME=

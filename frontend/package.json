{
  "name": "ai-exam-training-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.19.0",
    "npm": "10.9.3"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:e2e": "cross-env VITE_EXAM_SIMULATOR_MOCK=true VITE_EXAM_SIMULATOR_START_DELAY_SECONDS=1 vite --host 127.0.0.1 --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node ./scripts/verify-production-bundle.mjs",
    "test:e2e": "node ./scripts/run-playwright.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "axios": "^1.11.0",
    "element-plus": "^2.11.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
